# 複製為 .env.email(或 .env)並填值 —— 絕不 commit 真實值
# === Email(每日報告/名單信/風險信)===
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com          # 多收件人用逗號分隔
SMTP_USER=you@gmail.com
SMTP_PASSWORD=                 # Gmail 用應用程式密碼
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_FROM_NAME=Stock ML Bot
EMAIL_SUBJECT_PREFIX=[Stock ML]

# === ntfy 推播(選用;複製為 .env.ntfy)===
NTFY_TOPIC=
NTFY_URL=

# === 系統開關 ===
STOCK_BASE_DIR=                # 留空=repo 根目錄
CHIPK_DESKTOP_ENABLED=0        # 籌碼K桌面自動化已退役,保持 0
